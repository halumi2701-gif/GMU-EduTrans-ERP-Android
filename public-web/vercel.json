{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/jelajah",
      "destination": "/"
    },
    {
      "source": "/jelajah/:path*",
      "destination": "/"
    },
    {
      "source": "/akun",
      "destination": "/"
    },
    {
      "source": "/booking/checkout",
      "destination": "/"
    }
  ]
}
