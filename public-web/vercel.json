{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/edutrain",
      "destination": "/"
    },
    {
      "source": "/edutrain/:path*",
      "destination": "/"
    },
    {
      "source": "/jelajah",
      "destination": "/"
    },
    {
      "source": "/jelajah/:path*",
      "destination": "/"
    },
    {
      "source": "/akun",
      "destination": "/"
    },
    {
      "source": "/booking/checkout",
      "destination": "/"
    },
    {
      "source": "/tentang",
      "destination": "/"
    },
    {
      "source": "/portofolio",
      "destination": "/"
    },
    {
      "source": "/kemitraan",
      "destination": "/"
    },
    {
      "source": "/berita",
      "destination": "/"
    },
    {
      "source": "/kontak",
      "destination": "/"
    },
    {
      "source": "/recruitment",
      "destination": "/recruitment.html"
    },
    {
      "source": "/wilayah",
      "destination": "/"
    },
    {
      "source": "/destinasi",
      "destination": "/"
    },
    {
      "source": "/klien-mitra",
      "destination": "/"
    },
    {
      "source": "/testimoni",
      "destination": "/"
    },
    {
      "source": "/faq",
      "destination": "/"
    },
    {
      "source": "/legal/privasi",
      "destination": "/"
    },
    {
      "source": "/legal/syarat-ketentuan",
      "destination": "/"
    }
  ]
}