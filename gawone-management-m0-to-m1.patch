+                    Text("Akun: ${p.optString("account_status","-")} · ${p.optString("availability_status","-")}")
+                    Text("Onboarding: ${on?.optString("status","-")?:"-"}")
+                    Text("Dokumen current: ${docRows.size} · Service aktif: ${serviceRows.size}",color=Color.Gray)
+                    if(docRows.isNotEmpty()){
+                        HorizontalDivider()
+                        Text("Dokumen KYC",fontWeight=FontWeight.SemiBold)
+                        docRows.forEach{d->DocumentReviewRow(api,d,canVerify,onChanged)}
+                    }
+                    if(serviceRows.isNotEmpty()){
