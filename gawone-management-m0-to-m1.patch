+@Composable private fun PartnerScreen(api:ManagementApi,s:ManagementState,onChanged:()->Unit){
+    val canVerify=s.permissions.contains("partner.verify")
+    Scrollable{
+        SectionTitle("Mitra & KYC")
+        if(!canVerify) Info("Mode observasi","Akun ini dapat membaca data Mitra, tetapi tidak memiliki permission partner.verify.")
+        if(s.partners.length()==0) Empty("Belum ada Mitra production. Instal APK Mitra Pilot RC3 dan selesaikan OTP + onboarding untuk memunculkan kandidat pertama.")
+        else for(i in 0 until s.partners.length()){
+            val p=s.partners.optJSONObject(i)?:continue
+            val id=p.optString("id")
+            val on=findBy(s.onboarding,"partner_id",id)
