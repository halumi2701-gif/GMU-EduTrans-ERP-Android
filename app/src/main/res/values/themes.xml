<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GMUEduTransERP" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/gmu_dark</item>
        <item name="android:navigationBarColor">@color/gmu_dark</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.GMUEduTransERP.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/gmu_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_gmu</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/white</item>
        <item name="postSplashScreenTheme">@style/Theme.GMUEduTransERP</item>
    </style>
</resources>
